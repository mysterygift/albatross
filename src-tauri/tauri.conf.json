{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Albatross",
  "version": "0.2.0",
  "identifier": "com.albatross",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Albatross",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "sql": { "preload": ["sqlite:albatross.db"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["apf"],
        "name": "Albatross Project File",
        "description": "Albatross Project File",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.albatross.apf",
          "conformsTo": ["public.data", "public.archive"]
        }
      }
    ]
  }
}
